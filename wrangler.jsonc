{
  // WARNING: TANEXPO's live Express backend + embedded PGlite database
  // CANNOT run on Cloudflare Workers or Cloudflare Pages static hosting ("./dist" has no /api/*).
  // Deploy on a Node.js host with a persistent disk (Render, see render.yaml and DEPLOYMENT.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanexpo",
  "compatibility_date": "2024-09-23",
  "pages_build_output_dir": "./dist"
}
