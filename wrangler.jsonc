{
  // WARNING: TANEXPO's live Express backend + embedded PGlite database (/data/pg)
  // CANNOT run on Cloudflare Workers or Cloudflare Pages static hosting ("./dist" has no /api/*).
  // Deploy using the root Dockerfile on a stateful Node.js host with a persistent volume
  // (Fly.io, Render, Railway, etc.). See DEPLOYMENT.md for full instructions.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanexpo",
  "compatibility_date": "2024-09-23",
  "pages_build_output_dir": "./dist"
}
