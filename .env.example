# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: public URL of the site (used in the WhatsApp signpost reply).
APP_URL="MY_APP_URL"

# Server-side platform commission rate (0.15 = 15%)
COMMISSION_RATE="0.15"

# Session lifetime in days
SESSION_TTL_DAYS="7"

# Demo reset gate (must NEVER be enabled in production)
ALLOW_DEMO_RESET="false"

# Non-production demo user passwords (only seeded when NODE_ENV !== 'production')
DEMO_TOURIST_PASSWORD=""
DEMO_PROVIDER_PASSWORD=""

# Optional admin seed credentials (only way to create an admin account)
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""

# Persistent PGlite database directory (set to a persistent volume in production, e.g. /var/data/pg)
PG_DATA_DIR="./.data/pg"

# Where operators' package photos and videos are stored. Defaults to a "media" folder next to
# PG_DATA_DIR, so it lives on the same persistent disk (e.g. /var/data/media).
MEDIA_DIR=""

# Payment rails mode: "simulated" (sandbox checkout) or "live" (blocks simulated checkout/transaction writes)
PAYMENTS_MODE="simulated"

# Seed demo catalog/users on an empty database (defaults to false in production, true in non-production)
SEED_DEMO_CATALOG=""

# Comma-separated frame-ancestors allowed in CSP (defaults to 'none' in production, AI Studio preview hosts in dev)
ALLOW_FRAME_ANCESTORS=""

# WhatsApp (see docs/WHATSAPP_SETUP.md). With WHATSAPP_ENABLED=false nothing is sent to Meta.
WHATSAPP_ENABLED="false"
WHATSAPP_VERIFY_TOKEN=""
# Required before the webhook accepts anything in production
WHATSAPP_APP_SECRET=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_GRAPH_VERSION="v21.0"
# Dashboard chat preview while WhatsApp is off. On by default outside production.
# Set "true" on a demo deployment; turn off once real WhatsApp is live.
ALLOW_WHATSAPP_SIMULATOR="false"
# No business-initiated messages in these hours, Dar es Salaam time. "off" disables.
WHATSAPP_QUIET_HOURS="21-7"
# Set "false" to stop the reminder/digest scheduler in this process
SCHEDULER_ENABLED="true"

# Gemini model used to read forwarded customer messages
GEMINI_MODEL="gemini-3.8-flash"

# GEOAPIFY_API_KEY: Optional. Street-map tiles from Geoapify (free plan: 3,000 credits/day,
# commercial use allowed with attribution, no card). Get one at https://myprojects.geoapify.com
# and restrict it to your domain there: map keys are visible in the browser by design.
# Leave empty to use OpenStreetMap's public tiles (fine for demos, not for heavy traffic).
GEOAPIFY_API_KEY=""

# ---- Free hosting: Supabase (database + photo/video storage) ----
# DATABASE_URL: Supabase > Connect > "Session pooler" connection string, with your database password.
# Leave empty to use the embedded database in PG_DATA_DIR (laptop demos, tests).
DATABASE_URL=""
# The app's tables go in this schema, which Supabase does not publish through its web API.
# DATABASE_SCHEMA="tanexpo"
# Optional: Supabase's CA certificate (PEM text) to verify the database's TLS certificate.
# DATABASE_CA_CERT=""
# SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY: put operators' package photos/videos in Supabase Storage.
# Use a SECRET key (sb_secret_..., Settings > API Keys). Server-only: never in the frontend or chat.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="listing-media"
